{
  "rewrites": [
    {
      "source": "/api/system/health",
      "destination": "/api/reservation?ccRoute=system-health"
    },
    {
      "source": "/api/camp/stays",
      "destination": "/api/reservation?ccRoute=camp-stays"
    },
    {
      "source": "/api/clients/list",
      "destination": "/api/reservation?ccRoute=clients-list"
    },
    {
      "source": "/api/clients/detail",
      "destination": "/api/reservation?ccRoute=clients-detail"
    },
    {
      "source": "/api/clients/note",
      "destination": "/api/reservation?ccRoute=clients-note"
    },
    {
      "source": "/api/inbox/activity",
      "destination": "/api/reservation?ccRoute=inbox-activity"
    },
    {
      "source": "/api/inbox/save-draft",
      "destination": "/api/reservation?ccRoute=inbox-save-draft"
    },
    {
      "source": "/api/inbox/send-reply",
      "destination": "/api/reservation?ccRoute=inbox-send-reply"
    },
    {
      "source": "/api/inbox/thread",
      "destination": "/api/reservation?ccRoute=inbox-thread"
    },
    {
      "source": "/api/stay/panel",
      "destination": "/api/reservation?ccRoute=stay-panel"
    },
    {
      "source": "/api/stay/admin",
      "destination": "/api/reservation?ccRoute=stay-admin"
    },
    {
      "source": "/api/analytics/event",
      "destination": "/api/reservation?ccRoute=analytics-event"
    },
    {
      "source": "/api/analytics/dashboard",
      "destination": "/api/reservation?ccRoute=analytics-dashboard"
    },
    {
      "source": "/api/analytics/feedback",
      "destination": "/api/reservation?ccRoute=analytics-feedback"
    },
    {
      "source": "/api/analytics/recommendations",
      "destination": "/api/reservation?ccRoute=analytics-recommendations"
    },
    {
      "source": "/api/analytics/report",
      "destination": "/api/reservation?ccRoute=analytics-report"
    },
    {
      "source": "/api/analytics/status",
      "destination": "/api/reservation?ccRoute=analytics-status"
    },
    {
      "source": "/stay/:token",
      "destination": "/stay/?token=:token"
    }
  ],
  "headers": [
    {
      "source": "/stay/:path*",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "Cache-Control", "value": "private, no-store, max-age=0" }
      ]
    }
  ]
}
